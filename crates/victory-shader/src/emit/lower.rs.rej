diff a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs	(rejected hunks)
@@ -4380,18 +4458,6 @@ impl<'a> Lower<'a> {
         (self.s.m.select(c, any, at, first), any)
